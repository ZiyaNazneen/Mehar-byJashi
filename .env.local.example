# -----------------------------------------------------------------------------
# Mehar by Jashi — Local Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local and replace the placeholder values with your
# Supabase project credentials from:
# Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------

# Public Supabase URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon API Key (Safe to expose to browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Default Storefront Currency (Default: INR)
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
